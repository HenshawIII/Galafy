# ALAT pilot (Azure API Management) — set real values in deployment or a gitignored `.env`.
# Do not commit production secrets.

# Partner `x-api-key` (KYC requests + payment webhook verification)
PROVIDER_API_KEY=

# APIM subscription key (Ocp-Apim-Subscription-Key for KYC and debit-wallet when separate keys are not set)
PROVIDER_KYC_SUBSCRIPTION_KEY=

# KYC base URL. You can set host-only (`https://...azure-api.net`) or full KYC path;
# service normalizes to `.../create-account-face/api`.
PROVIDER_KYC_BASE_URL=https://lagos-alat-blueapi.azure-api.net

# Account-upgrade API (Tier 2/3 upgrade + partner KYC status). Defaults to {gateway}/account-upgrade/api
# PROVIDER_ACCOUNT_UPGRADE_BASE_URL=https://lagos-alat-blueapi.azure-api.net/account-upgrade/api

# Account maintenance API (admin wallet details + provider transaction history). Defaults to {gateway}/ws-acct-mgt/api
# Auth: x-api-key (PROVIDER_API_KEY) + Ocp-Apim-Subscription-Key (PROVIDER_KYC_SUBSCRIPTION_KEY) — same as KYC.
# PROVIDER_ACCOUNT_MAINTENANCE_BASE_URL=https://lagos-alat-blueapi.azure-api.net/ws-acct-mgt/api

# Debit-wallet: partner `access` header (falls back to PROVIDER_API_KEY).
# PROVIDER_DEBIT_WALLET_ACCESS_KEY=
# APIM subscription for debit-wallet (falls back to PROVIDER_KYC_SUBSCRIPTION_KEY).
# PROVIDER_DEBIT_WALLET_APIM_KEY=
# PROVIDER_DEBIT_WALLET_PROCESS_CLIENT_TRANSFER_URL=

# Tier 1 BVN at-rest encryption (32-byte key, base64). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BVN_ENCRYPTION_KEY=
# HMAC pepper for tier1BvnHash duplicate detection (long random string)
BVN_HMAC_PEPPER=

# Admin TOTP 2FA — 32-byte AES key (base64). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Falls back to SHA-256(ADMIN_JWT_SECRET) when unset.
ADMIN_2FA_ENCRYPTION_KEY=
# Issuer name shown in authenticator apps (default: Galafy Admin)
# ADMIN_2FA_ISSUER=Galafy Admin

# Optional override for email header logo URL (defaults to embedded logo.png)
# APP_ICON_URL=https://your-cdn.example.com/logo.png

# Comma-separated extra browser origins allowed for CORS (ops + localhost always included)
# ADMIN_ALLOWED_ORIGINS=https://staging-ops.example.com

# iOS App Store numeric id for version check (default: 6755791850 — My Galafy)
# IOS_APP_STORE_ID=6755791850
