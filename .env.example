# ALAT pilot (Azure API Management) — set real values in deployment or a gitignored `.env`.
# Do not commit production secrets.

# Partner `x-api-key` (KYC requests + payment webhook verification)
PROVIDER_API_KEY=

# APIM subscription key (Ocp-Apim-Subscription-Key for KYC and debit-wallet when separate keys are not set)
PROVIDER_KYC_SUBSCRIPTION_KEY=

# Optional: full KYC base (defaults to PROVIDER_APIM_GATEWAY_URL + /create-account-face/api)
PROVIDER_KYC_BASE_URL=https://lagos-alat-blueapi.azure-api.net/create-account-face/api
# Optional: same APIM host without path (defaults from KYC URL or pilot host below)
# PROVIDER_APIM_GATEWAY_URL=https://lagos-alat-blueapi.azure-api.net
# Optional: full debit-wallet base only if it differs from the KYC host (otherwise derived from PROVIDER_KYC_BASE_URL)
# PROVIDER_DEBIT_WALLET_BASE_URL=

# Optional overrides (default to PROVIDER_API_KEY / PROVIDER_KYC_SUBSCRIPTION_KEY)
# PROVIDER_DEBIT_WALLET_ACCESS_KEY=
# PROVIDER_DEBIT_WALLET_APIM_KEY=
# PROVIDER_DEBIT_WALLET_PROCESS_CLIENT_TRANSFER_URL=
