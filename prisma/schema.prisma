// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================
// ENUMS
// =====================

enum KycTier {
  Tier_0
  Tier_1
  Tier_2
  Tier_3
}

enum TransactionType {
  INFLOW
  SPRAY
  PAYOUT
  REFUND
  ADJUSTMENT
}

enum TransactionDirection {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum FundingChannel {
  BANK_TRANSFER
  CARD
  USSD
  MANUAL_ADJUSTMENT
}

enum FundingStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REJECTED
  REVERSED
}

enum EventStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
}

// Only these three as requested
enum EventRole {
  ATTENDEE
  PERFORMER
  CELEBRANT
}

enum AdminRole {
  SUPER_ADMIN
  OPERATIONS
  COMPLIANCE
  SUPPORT
  FINANCE_ADMIN
  VIEW_ONLY
}

enum KycRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum UtilityBillStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AlertStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ConfigType {
  STRING
  NUMBER
  DECIMAL
  BOOLEAN
  JSON
}

// =====================
// CORE USER / AUTH
// =====================

model User {
  id                    String    @id @default(uuid())
  firstName             String?
  lastName              String?
  email                 String    @unique
  username              String?   @unique
  profilePicture        String?
  password              String?
  phone                 String?   @unique
  isVerified            Boolean   @default(false)
  verificationCode      String?
  passwordResetOtp      String?
  refreshToken          String?   @unique
  refreshTokenExpiresAt DateTime?

  // Payout security
  payoutPin             String?   // Hashed PIN for payout verification
  payoutOtp             String?   // Temporary OTP for payout confirmation
  payoutOtpExpiresAt    DateTime? // OTP expiration time
  pinResetOtp           String?   // Temporary OTP for PIN reset
  pinResetOtpExpiresAt DateTime? // PIN reset OTP expiration time
  pendingPayoutData     Json?     // Temporary storage for pending payout details

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer            Customer?
  notificationDevices NotificationDevice[]
  notifications        Notification[]
  settings            UserSettings?

  // Events user participates in
  eventParticipants EventParticipant[]
  // Events this user hosts
  hostedEvents      Event[]            @relation("UserHostedEvents")

  @@index([username]) // Index for username search
}

model UserSettings {
  id String @id @default(uuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Privacy Settings
  showOnLeaderboard   Boolean @default(false)
  allowMentionsOrTags Boolean @default(true)
  showOnlineStatus    Boolean @default(false)
  visibleAtEvents     Boolean @default(true)

  // Notification Settings
  pushNotifications  Boolean @default(true)
  eventReminders     Boolean @default(true)
  leaderboardUpdates Boolean @default(false)
  newFollowerAlerts  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationDevice {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  deviceToken String  @unique
  deviceType  String // 'web', 'android', 'ios', etc.
  appVersion  String?

  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  walletCreationEvents WalletCreationEvent[]
}

model Notification {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    String // Notification type: 'EVENT_REMINDER_10MIN', 'EVENT_STARTED', 'EVENT_REJOIN', 'SPRAY_RECEIVED', 'EVENT_PARTICIPANT_JOINED', 'INFLOW_RECEIVED', etc.
  title   String
  message String
  data    Json?  // Additional data payload

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

// =====================
// CUSTOMER & KYC
// =====================

model Customer {
  id String @id @default(uuid())

  // Link to your app user
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Provider-side identifiers
  providerCustomerId String? @unique
  organizationId     String?
  customerTypeId     String?
  countryId          String?

  // Tier management
  tier             KycTier @default(Tier_0)
  providerTierCode Int     @default(0)

  // Personal data
  firstName           String
  lastName            String
  middleName          String?
  dob                 DateTime?
  city                String?
  address             String?
  mobileNumber        String?
  emailAddress        String?
  isCorporateVerified Boolean?
  providerDateCreated DateTime?

  // KYC verification relations
  ninVerification     NinVerification?
  bvnVerification     BvnVerification?
  addressVerification AddressVerification?

  // Wallets
  wallets Wallet[]

  // Bank accounts
  bankAccounts BankAccount[]

  // KYC workflow requests
  kycRequests KycRequest[]

  // Admin fees
  adminFees AdminFee[]

  // Utility bill submissions
  utilityBillSubmissions UtilityBillSubmission[]

  // Withdrawal limit
  withdrawalLimit WithdrawalLimit?

  // AML restriction
  isAmlRestricted    Boolean   @default(false)
  amlRestrictedAt    DateTime?
  amlRestrictionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------
// NIN Verification
// --------------------

model NinVerification {
  id         Int      @id @default(autoincrement())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  providerCheckId Int?

  state  String?
  status String?

  ninCheckStatus String?
  firstnameMatch Boolean?
  lastnameMatch  Boolean?

  ninBirthdate     DateTime?
  ninGender        String?
  ninPhone         String?
  lgaOfResidence   String?
  stateOfResidence String?

  vNin String?

  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

// --------------------
// BVN Verification
// --------------------

model BvnVerification {
  id         Int      @id @default(autoincrement())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  kycCompleted    Boolean?
  providerCheckId Int?

  state  String?
  status String?

  bvnCheckStatus String?
  firstnameMatch Boolean?
  lastnameMatch  Boolean?

  birthdate          DateTime?
  gender             String?
  phone              String?
  email              String?
  firstname          String?
  lastname           String?
  middlename         String?
  lgaOfResidence     String?
  maritalStatus      String?
  nationality        String?
  residentialAddress String?
  stateOfResidence   String?
  enrollmentBank     String?
  watchListed        String?

  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

// --------------------
// Address Verification
// --------------------

model AddressVerification {
  id         Int      @id @default(autoincrement())
  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  verified        Boolean
  houseAddress    String?
  houseOwner      String?
  confidenceLevel Int?
  discoCode       String?

  providerStatus    String?
  providerMessage   String?
  providerTimestamp DateTime?

  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())
}

// =====================
// WALLET & TRANSACTIONS
// =====================

model Wallet {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  providerWalletId String? @unique

  walletGroupId          String?
  walletRestrictionId    String?
  walletClassificationId String?
  currencyId             String // provider's currency UUID

  availableBalance Decimal  @default(0) @db.Decimal(19, 2)
  ledgerBalance    Decimal  @default(0) @db.Decimal(19, 2)
  overdraft        Decimal? @default(0) @db.Decimal(19, 2)

  isInternal Boolean @default(false)
  isDefault  Boolean @default(false)

  name   String?
  mobNum String?

  virtualAccountNumber String?
  virtualBankCode      String?
  virtualBankName      String?

  // Risk scoring fields
  riskScore          Decimal?  @db.Decimal(5, 2) // Current risk score (0-100)
  riskStatus         String    @default("NORMAL") // NORMAL, SOFT_FREEZE, HARD_FREEZE
  riskScoreUpdatedAt DateTime?
  riskMetadata       Json? // Store component scores and calculation details

  // Relations
  transactions      Transaction[]
  spraysAsSprayer   Spray[]               @relation("SpraySprayerWallet")
  spraysAsReceiver  Spray[]               @relation("SprayReceiverWallet")
  fundings          FundingTransaction[]
  payouts           PayoutTransaction[]
  eventParticipants EventParticipant[]
  adminFees         AdminFee[]
  creationEvents    WalletCreationEvent[]
  amlAlerts         AmlAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transaction {
  id String @id @default(uuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  type      TransactionType
  direction TransactionDirection
  status    TransactionStatus    @default(PENDING)

  amount     Decimal @db.Decimal(19, 2)
  currencyId String // same as wallet.currencyId

  groupReference    String?
  reference         String  @unique // your internal reference
  externalReference String? // generic provider reference if needed

  narration String?
  metadata  Json?

  // One-to-one links to domain-specific transactions
  fundingTransaction FundingTransaction? @relation("FundingTransactionOnTransaction")
  payoutTransaction  PayoutTransaction?  @relation("PayoutTransactionOnTransaction")
  spray              Spray?              @relation("SprayOnTransaction")

  // Admin fees linked to this transaction
  adminFees AdminFee[] @relation("AdminFeeOnTransaction")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// EVENTS & SPRAYS
// =====================

model Event {
  id   String @id @default(uuid())
  code String @unique

  // Basic event info
  title       String
  name        String // Keep for backward compatibility, can be same as title
  location    String
  category    String
  description String?
  imageUrl    String?
  imagePath   String?

  // Event settings
  goLiveInstantly     Boolean  @default(false)
  sprayGoal           Decimal? @db.Decimal(19, 2)
  minSprayAmount      Decimal? @db.Decimal(19, 2)
  enableLeaderboard   Boolean  @default(true)
  anonSprayersAllowed Boolean  @default(true)
  taggedPerformer     String?

  // Scheduling
  hostUserId String
  hostUser   User   @relation("UserHostedEvents", fields: [hostUserId], references: [id])

  status   EventStatus @default(DRAFT)
  startsAt DateTime
  endsAt   DateTime?

  participants EventParticipant[]
  sprays       Spray[]
  visibility   EventVisibility    @default(PUBLIC)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([hostUserId])
  @@index([status, startsAt])
  @@index([status, endsAt])
  @@index([title]) // Index for event title search
  @@index([location]) // Index for location filter
  @@index([startsAt]) // Index for date/time filter
  @@index([endsAt]) // Index for end date filter
}

model EventParticipant {
  id String @id @default(uuid())

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id])

  role      EventRole @default(ATTENDEE)
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId, role])
}

model Spray {
  id String @id @default(uuid())

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id])

  sprayerWalletId String
  sprayerWallet   Wallet @relation("SpraySprayerWallet", fields: [sprayerWalletId], references: [id])

  receiverWalletId String
  receiverWallet   Wallet @relation("SprayReceiverWallet", fields: [receiverWalletId], references: [id])

  // Link to ledger - transaction for the debit (from sprayer)
  transactionId String?      @unique
  transaction   Transaction? @relation("SprayOnTransaction", fields: [transactionId], references: [id])

  transactionGroupReference String? @unique

  totalAmount Decimal @db.Decimal(19, 2)
  note        String?
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// BANK ACCOUNTS & PAYMENTS
// =====================

model BankAccount {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  accountName   String
  accountNumber String
  bankCode      String // e.g. "058"

  isDefault             Boolean @default(false)
  isVerified            Boolean @default(false)
  providerRecipientCode String?

  payouts PayoutTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FundingTransaction {
  id String @id @default(uuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  amount Decimal @db.Decimal(19, 2)
  fee    Decimal @default(0) @db.Decimal(19, 2)

  channel FundingChannel
  status  FundingStatus  @default(PENDING)

  // Link to ledger
  transactionId String      @unique
  transaction   Transaction @relation("FundingTransactionOnTransaction", fields: [transactionId], references: [id])

  providerReference String? @unique
  providerPayload   Json?

  // Admin fee tracking
  adminFee AdminFee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PayoutTransaction {
  id String @id @default(uuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])

  amount Decimal @db.Decimal(19, 2)
  fee    Decimal @default(0) @db.Decimal(19, 2)

  status PayoutStatus @default(PENDING)

  // Link to ledger
  transactionId String      @unique
  transaction   Transaction @relation("PayoutTransactionOnTransaction", fields: [transactionId], references: [id])

  // Provider transactionRef
  providerTransactionRef String? @unique

  providerPayload Json?

  // Admin fee tracking
  adminFee AdminFee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerTransactionRef])
}

// =====================
// ADMIN FEES
// =====================

model AdminFee {
  id String @id @default(uuid())

  // Link to customer/wallet (who paid the fee)
  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id])

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // Fee details
  amount        Decimal  @db.Decimal(19, 2) // The fee amount
  feeType       String // 'funding' | 'payout'
  feePercentage Decimal? @db.Decimal(5, 4) // e.g., 0.03 for 3%, 0.10 for 10%

  // Link to the related user transaction (for reference)
  // This is the transaction that triggered the fee
  relatedTransactionId String?
  relatedTransaction   Transaction? @relation("AdminFeeOnTransaction", fields: [relatedTransactionId], references: [id])

  // Link to domain-specific transactions (optional, for detailed tracking)
  fundingTransactionId String?             @unique
  fundingTransaction   FundingTransaction? @relation(fields: [fundingTransactionId], references: [id])

  payoutTransactionId String?            @unique
  payoutTransaction   PayoutTransaction? @relation(fields: [payoutTransactionId], references: [id])

  // Status tracking
  status String @default("COLLECTED") // 'COLLECTED' | 'REFUNDED' | 'REVERSED'

  // Metadata
  grossAmount              Decimal? @db.Decimal(19, 2) // Original amount before fee deduction
  netAmount                Decimal? @db.Decimal(19, 2) // Amount after fee deduction
  adminWalletAccountNumber String? // Which admin wallet received the fee

  metadata Json? // Additional context (provider references, etc.)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([walletId])
  @@index([customerId])
  @@index([feeType])
  @@index([relatedTransactionId])
  @@index([createdAt])
  @@index([status])
}

// =====================
// WEBHOOKS
// =====================

model ProviderWebhookEvent {
  id String @id @default(uuid())

  event            String // e.g. "payout"
  paymentReference String?
  payload          Json

  processingStatus WebhookProcessingStatus @default(PENDING)
  errorMessage     String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

// =====================
// ADMIN & KYC WORKFLOW
// =====================

model Admin {
  id String @id @default(uuid())

  email    String   @unique
  password String   // Hashed password
  userId   String?  @unique // Optional link to User if needed

  role     AdminRole
  isActive Boolean   @default(true)

  // Authentication tracking
  lastLoginAt         DateTime?
  failedLoginAttempts Int      @default(0)
  lockedUntil         DateTime?

  kycRequests KycRequest[]
  utilityBillReviews UtilityBillSubmission[]
  actionLogs AdminActionLog[]
  sentInvites AdminInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())
}

model AdminInvite {
  id String @id @default(uuid())

  email     String    @unique
  token     String    @unique
  role      AdminRole
  invitedBy String    // Admin ID who sent the invite
  inviter   Admin     @relation(fields: [invitedBy], references: [id])

  expiresAt DateTime
  usedAt    DateTime?
  accepted  Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([token])
  @@index([email])
  @@index([invitedBy])
}

model KycRequest {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  requestedTier KycTier
  status        KycRequestStatus @default(PENDING)

  adminId String?
  admin   Admin?  @relation(fields: [adminId], references: [id])

  reason    String?
  decidedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =====================
// WALLET CREATION TRACKING
// =====================

model WalletCreationEvent {
  id String @id @default(uuid())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  userId     String
  customerId String

  // Device identification
  deviceToken String? // Link to NotificationDevice.deviceToken
  deviceId    String? // Reference to NotificationDevice.id
  device      NotificationDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  // Network information
  ipAddress String? // IP address from request
  userAgent String? // Browser/OS information from User-Agent header

  // Browser fingerprint (can be sent from client)
  browserFingerprint String? // Client-side generated fingerprint
  os                 String? // Operating system
  browser            String? // Browser name/version

  // Abuse detection flags
  isFlagged         Boolean @default(false) // Flagged for review
  flagReason        String? // Reason for flagging
  deviceWalletCount Int? // Number of wallets from this device at creation time
  ipWalletCount     Int? // Number of wallets from this IP at creation time

  // Metadata
  metadata Json? // Additional context (request headers, etc.)

  createdAt DateTime @default(now())

  @@index([deviceToken])
  @@index([ipAddress])
  @@index([userId])
  @@index([walletId])
  @@index([isFlagged])
  @@index([createdAt])
}

// =====================
// UTILITY BILL SUBMISSIONS
// =====================

model UtilityBillSubmission {
  id String @id @default(uuid())

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  utilityBillUrl String // Image URL of utility bill
  status         UtilityBillStatus @default(PENDING)

  // Admin decision tracking
  adminId    String?
  admin      Admin?  @relation(fields: [adminId], references: [id])
  reviewedAt DateTime?
  reason     String? // Rejection reason or approval notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([adminId])
}

// =====================
// WITHDRAWAL LIMITS
// =====================

model WithdrawalLimit {
  id String @id @default(uuid())

  customerId String   @unique
  customer   Customer @relation(fields: [customerId], references: [id])

  // Daily withdrawal limits (in kobo)
  dailyLimit        Decimal @default(100000000) @db.Decimal(19, 2) // 1M default for Tier 2
  approvedDailyLimit Decimal? @db.Decimal(19, 2) // 10M after utility bill approval

  // Tracking
  lastResetDate DateTime @default(now()) // Track when daily limit was last reset
  dailyWithdrawn Decimal @default(0) @db.Decimal(19, 2) // Amount withdrawn today

  // Approval status
  isLimitIncreased Boolean @default(false) // True if utility bill approved

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

// =====================
// ADMIN ACTION LOGGING
// =====================

model AdminActionLog {
  id String @id @default(uuid())

  adminId String
  admin   Admin @relation(fields: [adminId], references: [id])

  actionType String // 'KYC_APPROVED', 'KYC_REJECTED', 'UTILITY_BILL_APPROVED', 'UTILITY_BILL_REJECTED', 'USER_RESTRICTED', etc.
  targetType String // 'CUSTOMER', 'UTILITY_BILL', 'KYC_REQUEST', 'USER'
  targetId   String // ID of the target entity

  details Json? // Additional action details
  reason  String? // Reason for action

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([actionType])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// =====================
// AML ALERTS
// =====================

model AmlAlert {
  id String @id @default(uuid())

  // Alert metadata
  eventType String // 'RISK_SCORE_CALCULATED', 'TRANSACTION_BLOCKED', 'ANOMALY_DETECTED', etc.
  severity String // 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'
  status AlertStatus @default(PENDING)

  // Related entities
  walletId String?
  wallet Wallet? @relation(fields: [walletId], references: [id])
  transactionId String?
  sprayId String?
  customerId String?
  userId String?
  eventId String?

  // Alert details (stored as JSON for flexibility)
  details Json // Contains riskScore, amount, blockReason, anomalyType, etc.
  context Json? // Additional context data

  // Admin tracking
  reviewedBy String? // Admin ID who reviewed
  reviewedAt DateTime?
  resolutionNotes String? // Notes when resolving/dismissing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([severity])
  @@index([eventType])
  @@index([createdAt])
  @@index([walletId])
  @@index([customerId])
  @@index([reviewedBy])
}

// =====================
// SYSTEM CONFIGURATION
// =====================

model SystemConfig {
  id          String     @id @default(uuid())
  key         String     @unique // e.g., "ADMIN_PAYOUT_FEE", "RISK_VELOCITY_MAX"
  category    String     // e.g., "FEES", "RISK", "DEVICE_ABUSE", "ANOMALY", "EVENT", "SYSTEM"
  value       String     // Stored as string, parsed based on type
  type        ConfigType // STRING, NUMBER, DECIMAL, BOOLEAN, JSON
  description String?    // Human-readable description
  isActive    Boolean    @default(true)
  updatedBy   String?    // Admin user ID who last updated
  updatedAt   DateTime   @updatedAt
  createdAt   DateTime   @default(now())

  @@index([category])
  @@index([isActive])
  @@index([key])
}
